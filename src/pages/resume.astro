---
import Layout from '../layouts/Layout.astro';

const resumeFile = '/files/Sourojit_Resume_02.pdf';
---

<Layout title="Resume — Sourojit Saha">
  <section class="resume-page">
    <div class="container">
      <div class="resume-header">
        <div>
          <p class="section-label">Document</p>
          <h1 class="section-title" style="margin-bottom:0;">Resume</h1>
        </div>
        <a href={resumeFile} download class="btn btn-primary">
          <i class="fa-solid fa-download"></i> Download PDF
        </a>
      </div>

      <div class="resume-viewer">
        <iframe
          src={resumeFile}
          title="Sourojit Saha Resume"
        ></iframe>
        <p class="resume-fallback">
          PDF not displaying?
          <a href={resumeFile} target="_blank" rel="noopener">Open in a new tab</a>
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .resume-page {
    padding: 8rem 0 4rem;
    min-height: 100vh;
  }

  .resume-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .resume-viewer {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .resume-viewer iframe {
    display: block;
    width: 100%;
    height: 85vh;
    border: none;
  }

  .resume-fallback {
    padding: 0.75rem 1.25rem;
    font-size: 0.8rem;
    color: var(--text-muted);
    border-top: 1px solid var(--border);
    text-align: center;
  }

  .resume-fallback a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
