<section class="section" id="experience" style="background: var(--bg-surface);">
  <div class="container">
    <div class="section-header reveal">
      <p class="section-label">Background</p>
      <h2 class="section-title">Experience &amp; Education</h2>
    </div>

    <div class="timeline reveal">

      <div class="timeline-item">
        <div class="timeline-dot current"></div>
        <div class="timeline-meta">
          <span class="timeline-date">2023 — Present</span>
          <span class="timeline-badge">Current</span>
        </div>
        <h3 class="timeline-title">Robotics Engineer</h3>
        <div class="timeline-org">Swarmbotics.ai</div>
        <div class="timeline-body">
          <p>
            First engineering hire at an early-stage robotics startup. Responsible for the
            full hardware-software stack — from designing multi-robot simulations to
            developing the physical prototype.
          </p>
          <p>Key contributions:</p>
          <ul style="padding-left:1.25rem; color:var(--text-secondary); font-size:0.9rem; line-height:1.7;">
            <li>Built robots from scratch including mechanical design, electronics integration, and software</li>
            <li>Developed multi-robot simulation environments for testing and validation</li>
            <li>Brought designs from simulation to working physical prototypes</li>
          </ul>
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-dot"></div>
        <div class="timeline-meta">
          <span class="timeline-date">2021 — 2023</span>
        </div>
        <h3 class="timeline-title">M.S. Robotics</h3>
        <div class="timeline-org">Carnegie Mellon University</div>
        <div class="timeline-body">
          <p>
            Graduate research and coursework across control systems, planning, computer
            vision, ML/AI, and SLAM. Worked on multi-robot systems involving RC cars and
            Boston Dynamics SPOT.
          </p>
          <p style="margin-top:0.75rem; font-size:0.85rem; color:var(--text-muted); font-weight:600; letter-spacing:0.05em; text-transform:uppercase;">
            Selected Coursework
          </p>
          <div class="timeline-courses">
            <span class="tag">Modern Control Theory</span>
            <span class="tag">Planning & Decision Making in Robots</span>
            <span class="tag">Robot Localization and Mapping</span>
            <span class="tag">Advanced Control Systems Integration</span>
            <span class="tag">Computer Vision</span>
            <span class="tag">ML and AI for Engineers</span>
            <span class="tag">Learning for 3D Vision</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
